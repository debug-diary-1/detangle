{
  "name": "detangle",
  "version": "0.1.3",
  "description": "Fast dependency analysis and architecture rules for JavaScript and TypeScript (CLI and Node.js API)",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/debug-diary-1/detangle.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/debug-diary-1/detangle#readme",
  "keywords": [
    "dependencies",
    "architecture",
    "lint",
    "cycles",
    "import",
    "typescript",
    "javascript",
    "monorepo"
  ],
  "bin": {
    "detangle": "bin/detangle.js"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    }
  },
  "files": [
    "bin/detangle.js",
    "binary.js",
    "platforms.json",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts"
  ],
  "optionalDependencies": {
    "detangle-darwin-arm64": "0.1.3",
    "detangle-darwin-x64": "0.1.3",
    "detangle-linux-arm64-gnu": "0.1.3",
    "detangle-linux-arm64-musl": "0.1.3",
    "detangle-linux-x64-gnu": "0.1.3",
    "detangle-linux-x64-musl": "0.1.3",
    "detangle-windows-arm64": "0.1.3",
    "detangle-windows-x64": "0.1.3"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint9": "npm:eslint@^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
