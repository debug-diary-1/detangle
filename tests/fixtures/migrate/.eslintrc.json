{
  // legacy config with comments
  "rules": {
    "import/no-cycle": ["error", { "maxDepth": 3 }],
    "import/no-restricted-paths": ["warn", { "zones": [{ "target": "./src/lib", "from": "./src/app", "message": "lib must not depend on app" }] }]
  },
  "overrides": [{ "files": ["*.test.ts"], "rules": { "import/no-cycle": "off" } }],
  "ignorePatterns": ["generated/"]
}
