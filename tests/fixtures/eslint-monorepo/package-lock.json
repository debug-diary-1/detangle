{
  "name": "eslint-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": { "name": "eslint-monorepo", "workspaces": ["packages/*"] },
    "packages/a": { "name": "@m/a", "dependencies": { "@m/b": "*" } },
    "packages/b": { "name": "@m/b", "dependencies": { "@m/a": "*" } }
  }
}
