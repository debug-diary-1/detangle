{
  "root": true,
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "depConstraints": [
          {
            "sourceTag": "scope:shop",
            "onlyDependOnLibsWithTags": [
              "scope:shop",
              "scope:shared"
            ],
            "bannedExternalImports": [
              "lodash"
            ]
          },
          {
            "sourceTag": "scope:admin",
            "onlyDependOnLibsWithTags": [
              "scope:admin",
              "scope:shared"
            ]
          },
          {
            "sourceTag": "scope:shared",
            "onlyDependOnLibsWithTags": [
              "scope:shared"
            ]
          },
          {
            "sourceTag": "type:app",
            "onlyDependOnLibsWithTags": [
              "*"
            ]
          },
          {
            "sourceTag": "type:feature",
            "onlyDependOnLibsWithTags": [
              "type:feature",
              "type:ui",
              "type:util"
            ]
          },
          {
            "sourceTag": "type:ui",
            "onlyDependOnLibsWithTags": [
              "type:ui",
              "type:util"
            ]
          },
          {
            "sourceTag": "type:util",
            "onlyDependOnLibsWithTags": [
              "type:util"
            ]
          }
        ]
      }
    ]
  }
}